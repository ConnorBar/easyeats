# Copy this file to `.env` (same folder) and fill in values.
# Do NOT commit your real `.env`.
#
# Local Mongo (default if you omit these):
# MONGODB_URI=mongodb://localhost:27017
# DATABASE_NAME=fridgebridge
#
# MongoDB Atlas (example format):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority
# DATABASE_NAME=fridgebridge

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
DATABASE_NAME=fridgebridge
